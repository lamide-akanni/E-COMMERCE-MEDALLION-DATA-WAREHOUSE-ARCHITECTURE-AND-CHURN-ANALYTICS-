CREATE OR ALTER VIEW gold.dim_currency AS
SELECT
    ROW_NUMBER() OVER (ORDER BY currency_code) AS currency_key,
    currency_code,
    currency_name
FROM (
    VALUES
        ('GBP', 'British Pound'),
        ('USD', 'US Dollar'),
        ('EUR', 'Euro'),
        ('CAD', 'Canadian Dollar'),
        ('AUD', 'Australian Dollar')
) c(currency_code, currency_name);
GO
